mixin headerBurger(header)
  - const pageAppearanceRef = typeof pageAppearance !== "undefined" ? pageAppearance : {}
  - const burgerVariant = resolveHeaderBurger(pageAppearanceRef)
  - const burgerItemCount = burgerVariant === "dots" ? HEADER_BURGER_DOT_COUNT : 3

  button(
    type="button"
    class=headerBurgerClasses(pageAppearanceRef)
    aria-controls="header-navigation"
    aria-expanded="false"
    aria-label=header.menuOpenLabel
    data-open-label=header.menuOpenLabel
    data-close-label=header.menuCloseLabel
    data-js-header-burger-button
  )
    - for (let itemIndex = 0; itemIndex < burgerItemCount; itemIndex += 1)
      span.header-burger__line
