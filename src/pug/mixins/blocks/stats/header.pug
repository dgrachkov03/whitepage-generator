include /mixins/ui/eyebrow.pug

mixin statsHeader(statsData, options)
  - options = options || {}
  - const eyebrowVariant = resolveEyebrowVariant(options, pageAppearance)
  - const align = options.align || "start"
  - const headerClass = options.headerClass || (align === "center" ? "mx-auto flex max-w-2xl flex-col items-center gap-3 text-center sm:gap-4" : "flex max-w-2xl flex-col items-start gap-3 sm:gap-4")
  - const titleClass = options.titleClass || "type-section-title text-ink"
  - const descriptionClass = options.descriptionClass || "font-body text-base leading-relaxed text-ink-muted sm:text-lg"

  header(class=headerClass)
    if statsData.eyebrow
      +eyebrow(statsData.eyebrow, eyebrowVariant)

    h2(
      id="stats-title"
      class=titleClass
    )= statsData.title

    if statsData.description
      p(class=descriptionClass)= statsData.description
