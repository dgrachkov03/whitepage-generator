include /mixins/ui/button.pug
include /mixins/ui/checkbox.pug
include /mixins/ui/field.pug
include /mixins/ui/input.pug
include /mixins/ui/select.pug
include /mixins/ui/textarea.pug

mixin contactPhoneField(formData)
  +field(formData.phoneLabel, "contact-phone", { required: true })
    +input({
      id: "contact-phone",
      name: "phone",
      type: "tel",
      autocomplete: "tel",
      placeholder: formData.phonePlaceholder,
      required: true
    })(data-js-phone-input data-invalid-message="Veuillez saisir un numéro de téléphone valide.")

mixin contactForm(formData, options)
  - options = options || {}
  - const layout = options.layout || "stacked"
  - const formClass = options.formClass || "ui-tile flex flex-col gap-5 p-5 sm:p-6 lg:p-8"
  - const pairGridClass = "grid grid-cols-1 gap-5 sm:grid-cols-2"
  - const selectData = formData.select

  form(
    class=formClass
    method="post"
    aria-label=formData.label
    data-js-form
    data-phone-country=formData.phoneCountry
  )&attributes(attributes)
    +field(formData.nameLabel, "contact-name", { required: true })
      +input({
        id: "contact-name",
        name: "name",
        autocomplete: "name",
        placeholder: formData.namePlaceholder,
        required: true
      })

    if layout === "split-company-email"
      div(class=pairGridClass)
        +field(formData.companyLabel, "contact-company", { required: true })
          +input({
            id: "contact-company",
            name: "company",
            autocomplete: "organization",
            placeholder: formData.companyPlaceholder,
            required: true
          })

        +field(formData.emailLabel, "contact-email", { required: true })
          +input({
            id: "contact-email",
            name: "email",
            type: "email",
            autocomplete: "email",
            placeholder: formData.emailPlaceholder,
            required: true
          })

    else
      +field(formData.companyLabel, "contact-company", { required: true })
        +input({
          id: "contact-company",
          name: "company",
          autocomplete: "organization",
          placeholder: formData.companyPlaceholder,
          required: true
        })

      +field(formData.emailLabel, "contact-email", { required: true })
        +input({
          id: "contact-email",
          name: "email",
          type: "email",
          autocomplete: "email",
          placeholder: formData.emailPlaceholder,
          required: true
        })

    +contactPhoneField(formData)

    if selectData
      +field(selectData.label, "contact-select", { required: selectData.required })
        +selectField({
          id: "contact-select",
          name: selectData.name,
          placeholder: selectData.placeholder,
          options: selectData.options,
          required: selectData.required
        })

    +field(formData.messageLabel, "contact-message", { required: true })
      +textarea({
        id: "contact-message",
        name: "message",
        placeholder: formData.messagePlaceholder,
        required: true
      })

    div(class="flex flex-col gap-4")
      +checkbox(formData.consentText, "contact-consent", {
        name: "consent",
        required: true,
        linkText: formData.consentLinkText,
        linkHref: formData.consentLink
      })

      if formData.newsletterText
        +checkbox(formData.newsletterText, "contact-newsletter", {
          name: "newsletter"
        })

    +button(formData.submitText, {
      type: "submit",
      variant: "primary"
    })(class="w-full justify-center")

    if formData.footerNote
      p(class="font-body text-xs leading-relaxed text-ink-muted")= formData.footerNote
