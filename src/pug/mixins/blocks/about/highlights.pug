mixin aboutHighlights(highlights, iconSet, options)
  - options = options || {}
  - const listClass = options.listClass || "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5"

  ul(class=listClass role="list")
    each item in highlights
      li(class="ui-tile flex h-full flex-col items-start gap-4 p-5 sm:p-6")
        if item.icon
          span(
            class="inline-flex size-10 items-center justify-center rounded-button bg-surface-alt text-xl text-primary"
            aria-hidden="true"
          )!= libraryIcon(item.icon, iconSet)

        div(class="flex flex-col gap-2")
          h3(class="type-card-title text-ink")= item.title
          p(class="font-body text-sm leading-relaxed text-ink-muted sm:text-base")= item.text
