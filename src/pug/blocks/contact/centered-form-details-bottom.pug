include /mixins/blocks/contact/header.pug
include /mixins/blocks/contact/form.pug

- const contactData = site.contact || {}
- const contactDetails = site.contactInfo?.items || []
- const formData = contactData.form || {}
- const contactSectionId = contactData.sectionId || "contact"
- const contactAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.contact : undefined

if contactData.title && formData.label
  section(
    id=contactSectionId
    class=["py-section", blockClasses(contactAppearance)]
    aria-labelledby="contact-title"
  )
    div(class="flex justify-center px-4 sm:px-6 lg:px-8")
      div(class="flex w-full max-w-5xl flex-col items-center gap-8 sm:gap-10 lg:gap-12")
        +contactHeader(contactData, { align: "center" })

        +contactForm(formData, {
          layout: "stacked",
          formClass: "ui-tile flex w-full max-w-4xl flex-col gap-5 p-5 sm:p-7 lg:p-10"
        })

        if contactDetails.length
          address(class="not-italic")
            ul(
              class="flex w-full max-w-4xl flex-col gap-4 sm:flex-row sm:items-start sm:justify-center sm:gap-6"
              role="list"
            )
              each detail in contactDetails
                li(class="flex min-w-0 flex-1 flex-col items-center gap-2 text-center")
                  if detail.icon
                    span(
                      class="inline-flex size-10 items-center justify-center text-xl text-primary"
                      aria-hidden="true"
                    )!= libraryIcon(detail.icon, contactData.iconSet)

                  span(class="font-body text-sm font-semibold text-ink")= detail.label

                  if detail.href
                    a(class="ui-link text-sm text-ink-muted" href=detail.href)
                      span= detail.text
                  else
                    span(class="font-body text-sm leading-relaxed text-ink-muted")= detail.text
