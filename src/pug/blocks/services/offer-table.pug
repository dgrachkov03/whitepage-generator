include /mixins/blocks/services/header.pug
include /mixins/ui/link-button.pug

- const servicesData = site.services || {}
- const serviceItems = servicesData.items || []
- const servicesAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.services : undefined
- const offerServiceLabel = servicesData.offerServiceLabel || "Service"
- const offerDetailsLabel = servicesData.offerDetailsLabel || "Details"
- const offerDurationLabel = servicesData.offerDurationLabel || "Duration"
- const offerPriceLabel = servicesData.offerPriceLabel || "Price"

if servicesData.title && serviceItems.length
  section(
    id="services"
    class=["py-section", blockClasses(servicesAppearance)]
    aria-labelledby="services-title"
  )
    div(class="mx-auto flex min-w-0 max-w-6xl flex-col gap-8 px-4 sm:gap-10 sm:px-6 lg:gap-12 lg:px-8")
      +servicesHeader(servicesData, { align: "split" })

      ul(
        class="flex flex-col divide-y divide-ink/10 rounded-card border border-ink/10 md:hidden"
        role="list"
      )
        each item in serviceItems
          li(class="p-4 sm:p-5")
            article(class="flex flex-col gap-4" aria-label=item.title)
              h3(class="font-body text-sm font-semibold text-ink sm:text-base")= item.title

              p(class="font-body text-sm leading-relaxed text-ink-muted")= item.description

              dl(class="grid grid-cols-2 gap-x-4 gap-y-3 font-body text-sm")
                div
                  dt(class="text-xs font-semibold uppercase tracking-wide text-ink-muted")= offerDurationLabel
                  dd(class="mt-1 text-ink-muted")= item.duration || "—"

                div
                  dt(class="text-xs font-semibold uppercase tracking-wide text-ink-muted")= offerPriceLabel
                  dd(class="mt-1 font-semibold text-ink")= item.priceHint || "—"

              +linkButton(item.ctaText, item.ctaLink, {
                variant: item.ctaVariant || "secondary"
              })(class="w-full justify-center")

      div(class="hidden min-w-0 max-w-full overflow-x-auto rounded-card border border-ink/10 md:block")
        table(class="min-w-180 w-full border-collapse text-left")
          caption(class="sr-only")= servicesData.title

          thead
            tr(class="border-b border-ink/10 bg-surface-alt/60")
              th(
                scope="col"
                class="p-4 font-body text-sm font-semibold text-ink sm:p-5"
              )= offerServiceLabel

              th(
                scope="col"
                class="p-4 font-body text-sm font-semibold text-ink sm:p-5"
              )= offerDetailsLabel

              th(
                scope="col"
                class="w-32 p-4 font-body text-sm font-semibold text-ink sm:p-5"
              )= offerDurationLabel

              th(
                scope="col"
                class="w-36 p-4 font-body text-sm font-semibold text-ink sm:p-5"
              )= offerPriceLabel

              th(
                scope="col"
                class="w-40 p-4 sm:p-5"
              )
                span(class="sr-only") Action

          tbody
            each item in serviceItems
              tr(class="border-b border-ink/10 last:border-b-0")
                th(
                  scope="row"
                  class="p-4 align-top font-body text-sm font-semibold text-ink sm:p-5"
                )= item.title

                td(class="p-4 align-top font-body text-sm leading-relaxed text-ink-muted sm:p-5")= item.description

                td(class="p-4 align-top font-body text-sm text-ink-muted sm:p-5")= item.duration || "—"

                td(class="p-4 align-top font-body text-sm font-semibold text-ink sm:p-5")= item.priceHint || "—"

                td(class="p-4 align-top sm:p-5")
                  +linkButton(item.ctaText, item.ctaLink, {
                    variant: item.ctaVariant || "secondary"
                  })(class="w-full justify-center whitespace-nowrap sm:w-auto")
