- const topbarData = site.topbar || {}
- const topbarAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.topbar : undefined

if topbarData.message
  aside(
    class=blockClasses(topbarAppearance)
    aria-label=topbarData.label
  )
    div(class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-4 py-2.5 font-body text-xs leading-relaxed sm:flex-row sm:justify-center sm:px-6 lg:px-8")
      p(class="flex items-center gap-1.5 text-center")
        if topbarData.icon
          span(
            class="inline-flex size-4 shrink-0 text-current"
            aria-hidden="true"
          )!= libraryIcon(topbarData.icon, topbarData.iconSet)

        span= topbarData.message

      if topbarData.actionText && topbarData.actionLink
        a(
          class="inline-flex min-h-8 shrink-0 items-center justify-center rounded-button bg-primary px-4 py-1.5 font-semibold text-ink-inverse transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
          href=topbarData.actionLink
        )= topbarData.actionText
