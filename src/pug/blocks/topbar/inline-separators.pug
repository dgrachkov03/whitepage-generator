- const topbarData = site.topbar || {}
- const topbarContactTypes = topbarData.contactTypes || []
- const sharedContactItems = site.contactInfo?.items || []
- const topbarContacts = topbarContactTypes.map((type) => sharedContactItems.find((item) => item.type === type)).filter(Boolean)
- const topbarAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.topbar : undefined
- const hasAction = Boolean(topbarData.actionText && topbarData.actionLink)
- const trailingItems = []

if hasAction
  - trailingItems.push({ kind: "action" })

each detail in topbarContacts
  - trailingItems.push({ kind: "contact", detail })

if topbarData.message
  aside(
    class=blockClasses(topbarAppearance)
    aria-label=topbarData.label
  )
    div(class="mx-auto flex max-w-6xl flex-wrap items-center justify-center px-4 py-2.5 font-body text-xs leading-relaxed sm:px-6 lg:px-8")
      div(class="flex flex-wrap items-center justify-center gap-3")
        p(class="flex items-center gap-1.5 text-center")
          if topbarData.icon
            span(
              class="inline-flex size-4 shrink-0 text-current"
              aria-hidden="true"
            )!= libraryIcon(topbarData.icon, topbarData.iconSet)

          span= topbarData.message

        each item in trailingItems
          span(
            class="size-1 shrink-0 rounded-full bg-current opacity-60"
            aria-hidden="true"
          )

          if item.kind === "action"
            a(
              class="font-semibold text-current underline decoration-current/40 underline-offset-4 transition-opacity hover:opacity-70 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
              href=topbarData.actionLink
            )= topbarData.actionText
          else if item.detail.href
            a(
              class="font-semibold text-current transition-opacity hover:opacity-75 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
              href=item.detail.href
            )= item.detail.shortText || item.detail.text
          else
            span(class="font-semibold")= item.detail.shortText || item.detail.text
