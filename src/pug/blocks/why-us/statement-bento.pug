include /mixins/ui/eyebrow.pug

- const whyUsData = site.whyUs || {}
- const whyUsItems = whyUsData.items || []
- const whyUsAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.whyUs : undefined

if whyUsData.title && whyUsItems.length
  section(
    id="why-us"
    class=["py-section", blockClasses(whyUsAppearance)]
    aria-labelledby="why-us-title"
  )
    div(class="mx-auto grid max-w-6xl grid-cols-1 gap-5 px-4 sm:px-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-6 lg:px-8")
      header(class="flex min-h-full flex-col items-start justify-between gap-10 rounded-card bg-primary p-6 text-ink-inverse shadow-card sm:p-8 lg:p-10")
        div(class="flex flex-col items-start gap-4")
          if whyUsData.eyebrow
            +eyebrow(whyUsData.eyebrow, "inverse")

          h2(
            id="why-us-title"
            class="type-section-title text-current lg:text-5xl"
          )= whyUsData.title

        if whyUsData.description
          p(class="max-w-lg font-body text-base leading-relaxed text-current opacity-80")= whyUsData.description

      ul(class="grid grid-cols-1 gap-4 sm:grid-cols-2")
        each item, index in whyUsItems
          li(
            class=[
              "ui-tile flex min-h-full flex-col items-start gap-5 p-5 sm:p-6",
              index === 0 || index === whyUsItems.length - 1 ? "sm:col-span-2" : ""
            ]
          )
            if item.icon
              span(
                class="inline-flex size-10 items-center justify-center rounded-button bg-surface-alt text-xl text-primary"
                aria-hidden="true"
              )!= libraryIcon(item.icon, whyUsData.iconSet)

            div(class="flex flex-col gap-2")
              h3(class="type-card-title text-ink")= item.title
              p(class="font-body text-sm leading-relaxed text-ink-muted sm:text-base")= item.description
