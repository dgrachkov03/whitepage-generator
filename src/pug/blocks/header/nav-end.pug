include /mixins/ui/logo.pug
include /mixins/ui/link-button.pug
include /mixins/ui/text-link.pug
include /mixins/blocks/header/burger.pug

- const header = site.header || {}
- const headerIconSet = site.design && site.design.iconSet ? site.design.iconSet : "lucide"
- const headerNavigation = (site.navigation && site.navigation.primary) || {}
- const headerNavigationItems = headerNavigation.items || []
- const headerAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.header : undefined
- const headerMenu = resolveHeaderMenu(typeof pageAppearance !== "undefined" ? pageAppearance : {})

header(
  class=["site-header", "site-header--layout-end", headerMenuClass(pageAppearance), headerStickyClass(pageAppearance), blockClasses(headerAppearance)].filter(Boolean)
  data-js-header
  data-header-menu=headerMenu
)
  div(class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:min-h-20 sm:px-6 lg:px-8")
    +logo(site.brand)(data-js-header-logo)

    div(class="header-toolbar flex items-center gap-4")
      div(
        id="header-navigation"
        class="header-overlay"
        data-js-header-overlay
      )
        div(
          class="header-overlay__panel"
          data-js-header-overlay-wrapper
        )
          if headerNavigationItems.length
            nav(aria-label=headerNavigation.label)
              ul(class="flex flex-col gap-1 lg:flex-row lg:items-center lg:gap-1")
                each item in headerNavigationItems
                  li
                    +textLink(item.text, item.href)(
                      class="min-h-11 px-2"
                    )

          if header.ctaText && header.ctaLink
            +linkButton(header.ctaText, header.ctaLink, {
              variant: "primary",
              icon: header.ctaIcon,
              iconPosition: header.ctaIconPosition,
              iconSet: headerIconSet
            })

      +headerBurger(header)
