include /mixins/blocks/faq/accordion-items.pug
include /mixins/blocks/faq/header.pug

- const faqData = site.faq || {}
- const faqItems = faqData.items || []
- const faqAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.faq : undefined

if faqData.title && faqItems.length
  section(
    id="faq"
    class=["py-section", blockClasses(faqAppearance)]
    aria-labelledby="faq-title"
  )
    div(class="mx-auto flex max-w-3xl flex-col gap-8 px-4 sm:gap-10 sm:px-6 lg:gap-12 lg:px-8")
      +faqHeader(faqData, { align: "center" })
      +faqAccordionItems(faqItems)
