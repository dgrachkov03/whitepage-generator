include /mixins/blocks/about/header.pug
include /mixins/blocks/about/paragraphs.pug
include /mixins/blocks/about/quote.pug

- const aboutData = site.about || {}
- const aboutParagraphs = aboutData.paragraphs || []
- const aboutQuote = aboutData.quote || {}
- const aboutAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.about : undefined

if aboutData.title && aboutParagraphs.length && aboutQuote.text
  section(
    id="about"
    class=["py-section", blockClasses(aboutAppearance)]
    aria-labelledby="about-title"
  )
    div(class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-8 px-4 sm:gap-10 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8")
      div(class="flex flex-col items-start gap-6 sm:gap-8")
        +aboutHeader(aboutData)
        +aboutParagraphs(aboutParagraphs)

        if aboutData.image
          img(
            class="aspect-4/3 h-auto w-full max-w-md rounded-card object-cover shadow-card"
            src=aboutData.image
            alt=aboutData.imageAlt || ""
            width="640"
            height="480"
            loading="lazy"
            decoding="async"
          )

      +aboutQuote(aboutQuote)
