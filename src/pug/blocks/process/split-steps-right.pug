include /mixins/blocks/process/header.pug

- const processData = site.process || {}
- const processSteps = processData.items || []
- const processAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.process : undefined

if processData.title && processSteps.length
  section(
    id="process"
    class=["py-section", blockClasses(processAppearance)]
    aria-labelledby="process-title"
  )
    div(class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-4 sm:gap-10 sm:px-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-16 lg:px-8")
      ol(class="order-2 lg:order-1")
        each step, index in processSteps
          li(class="grid grid-cols-[auto_1fr] gap-4 border-t border-ink/10 py-6 first:border-t-0 sm:gap-6 sm:py-8")
            span(
              class="font-display text-2xl leading-none text-primary sm:text-3xl"
              aria-hidden="true"
            )= String(index + 1).padStart(2, "0")

            div(class="flex flex-col gap-2 sm:gap-3")
              h3(class="type-card-title text-ink")= step.title
              p(class="font-body text-sm leading-relaxed text-ink-muted sm:text-base")= step.description

      +processHeader(processData, {
        align: "split",
        headerClass: "order-1 flex flex-col items-start gap-4 lg:order-2 lg:py-6"
      })
