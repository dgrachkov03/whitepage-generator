include /mixins/blocks/process/header.pug

- const processData = site.process || {}
- const processSteps = processData.items || []
- const processAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.process : undefined

if processData.title && processSteps.length
  section(
    id="process"
    class=["py-section", blockClasses(processAppearance)]
    aria-labelledby="process-title"
  )
    div(class="mx-auto flex max-w-6xl flex-col gap-8 px-4 sm:gap-10 sm:px-6 lg:gap-12 lg:px-8")
      +processHeader(processData, { align: "center" })

      ol(
        class="process-timeline-grid relative grid gap-4 lg:gap-0"
        style=`--process-columns: ${processSteps.length}`
      )
        each step, index in processSteps
          li(class="relative flex min-h-full items-start gap-4 lg:flex-col lg:gap-5")
            if index < processSteps.length - 1
              span(
                class="absolute top-5.5 -bottom-9.5 left-5.5 w-px bg-ink/15 lg:hidden"
                aria-hidden="true"
              )

            div(class="flex flex-col items-center lg:w-full lg:flex-row")
              span(
                class="relative z-10 inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-primary font-display text-base text-ink-inverse shadow-card"
                aria-hidden="true"
              )= String(index + 1).padStart(2, "0")

              if index < processSteps.length - 1
                span(
                  class="hidden h-px flex-1 bg-ink/15 lg:block"
                  aria-hidden="true"
                )

            div(
              class=[
                "flex flex-col gap-2 lg:pr-4 lg:pb-0 xl:pr-8",
                index < processSteps.length - 1 ? "pb-6" : "pb-0"
              ]
            )
              h3(class="type-card-title text-ink")= step.title
              p(class="font-body text-sm leading-relaxed text-ink-muted sm:text-base")= step.description
