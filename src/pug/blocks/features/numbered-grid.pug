include /mixins/blocks/features/header.pug

- const featuresData = site.features || {}
- const featureItems = featuresData.items || []
- const featuresAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.features : undefined

if featuresData.title && featureItems.length
  section(
    id="features"
    class=["py-section", blockClasses(featuresAppearance)]
    aria-labelledby="features-title"
  )
    div(class="mx-auto flex max-w-6xl flex-col gap-8 px-4 sm:gap-10 sm:px-6 lg:gap-12 lg:px-8")
      +featuresHeader(featuresData, { align: "split" })

      ul(class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6")
        each item, index in featureItems
          li(class="ui-tile flex min-h-full flex-col gap-6 p-5 sm:p-6 lg:p-8")
            span(
              class="font-display text-2xl leading-none text-primary"
              aria-hidden="true"
            )= String(index + 1).padStart(2, "0")

            div(class="flex flex-col gap-3")
              h3(class="type-card-title text-ink")= item.title
              p(class="font-body text-sm leading-relaxed text-ink-muted sm:text-base")= item.description
