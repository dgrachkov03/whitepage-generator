include /mixins/blocks/features/header.pug
include /mixins/blocks/features/icon.pug
include /mixins/blocks/features/media.pug

- const featuresData = site.features || {}
- const featureItems = featuresData.items || []
- const featuresAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.features : undefined
- const leadItem = featureItems[0]
- const supportingItems = featureItems.slice(1)
- const leadMedia = leadItem ? leadItem.media || {} : {}

if featuresData.title && featureItems.length
  section(
    id="features"
    class=["py-section", blockClasses(featuresAppearance)]
    aria-labelledby="features-title"
  )
    div(class="mx-auto flex max-w-6xl flex-col gap-8 px-4 sm:gap-10 sm:px-6 lg:gap-12 lg:px-8")
      +featuresHeader(featuresData, { align: "split" })

      if leadItem
        article(
          class="grid grid-cols-1 items-center gap-6 overflow-hidden rounded-card bg-surface-alt shadow-card lg:grid-cols-2 lg:gap-0"
        )
          div(class="overflow-hidden")
            +featureMedia(leadMedia, { aspectClass: "aspect-4/3 lg:aspect-auto lg:min-h-80 lg:h-full", imageClass: "lg:min-h-80 lg:h-full" })

          div(class="flex flex-col items-start gap-5 p-6 sm:p-8 lg:p-10")
            +featureIcon(leadItem, featuresData.iconSet, 0, { sizeClass: "size-11" })

            div(class="flex flex-col gap-3")
              h3(class="type-card-title type-card-title--lg text-ink")= leadItem.title
              p(class="font-body text-base leading-relaxed text-ink-muted sm:text-lg")= leadItem.description

      if supportingItems.length
        ul(class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6")
          each item, index in supportingItems
            li(class="ui-tile flex min-h-full flex-col gap-4 p-5 sm:p-6")
              +featureIcon(item, featuresData.iconSet, index + 1, { sizeClass: "size-10" })

              div(class="flex flex-col gap-2")
                h3(class="type-card-title text-ink")= item.title
                p(class="font-body text-sm leading-relaxed text-ink-muted sm:text-base")= item.description
