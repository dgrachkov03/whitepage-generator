include /mixins/blocks/reviews/header.pug

- const reviewsData = site.reviews || {}
- const reviewItems = reviewsData.items || []
- const reviewsAppearance = typeof blockAppearance !== "undefined" ? blockAppearance.reviews : undefined
- const reviewIconSet = site.design && site.design.iconSet ? site.design.iconSet : "lucide"
- const carouselLabelsByLang = { fr: { prev: "Avis précédent", next: "Avis suivant" }, en: { prev: "Previous review", next: "Next review" }, de: { prev: "Vorherige Bewertung", next: "Nächste Bewertung" }, es: { prev: "Reseña anterior", next: "Reseña siguiente" }, it: { prev: "Recensione precedente", next: "Recensione successiva" }, pt: { prev: "Avaliação anterior", next: "Próxima avaliação" } }
- const carouselLang = (site.lang || "en").slice(0, 2)
- const carouselNavLabels = carouselLabelsByLang[carouselLang] || carouselLabelsByLang.en

if reviewsData.title && reviewItems.length
  section(
    id="reviews"
    class=["py-section", blockClasses(reviewsAppearance)]
    aria-labelledby="reviews-title"
  )
    div(
      class="mx-auto flex max-w-3xl flex-col gap-6 px-4 sm:px-6 lg:px-8"
      data-js-carousel
      data-carousel-effect="fade"
      data-carousel-slides="1,1,1"
      data-carousel-autoplay="5000"
      data-carousel-equal-height
      data-carousel-prev-label=carouselNavLabels.prev
      data-carousel-next-label=carouselNavLabels.next
    )
      +reviewsHeader(reviewsData, { align: "center" })

      div(class="ui-carousel ui-carousel--spotlight ui-carousel--bar-pagination")
        div(class="swiper ui-carousel__swiper")
          ul(class="swiper-wrapper")
            each review in reviewItems
              - const author = review.author || {}
              - const authorDisplay = author.display || "text"
              - const showAuthorAvatar = authorDisplay === "avatar" || authorDisplay === "avatar-text"
              - const showAuthorText = authorDisplay === "text" || authorDisplay === "avatar-text"
              - const authorInitials = author.name ? author.name.trim().split(/\s+/).slice(0, 2).map((part) => part.charAt(0)).join("") : ""

              li(class="swiper-slide")
                figure(class="ui-spotlight-slide mx-auto flex h-full min-h-full w-full flex-col text-center")
                  blockquote(class="flex flex-1 flex-col items-center justify-center gap-2.5 px-5 py-5 sm:gap-3 sm:px-7 sm:py-6")
                    span(class="ui-spotlight-quote text-primary" aria-hidden="true")!= libraryIcon("quote", reviewIconSet)
                    p(class="font-display text-lg italic leading-relaxed text-ink sm:text-xl sm:leading-snug")= review.quote

                  figcaption(class="mt-auto flex shrink-0 items-center justify-center gap-3 border-t border-border px-5 py-4 sm:px-7 sm:py-5")
                    if showAuthorAvatar
                      if author.photo
                        img(
                          class="size-10 shrink-0 rounded-full object-cover"
                          src=author.photo
                          alt=showAuthorText ? "" : author.name
                          width="40"
                          height="40"
                          loading="lazy"
                          decoding="async"
                        )
                      else
                        span(class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-primary font-body text-xs font-semibold uppercase text-ink-inverse")
                          span(aria-hidden="true")= authorInitials
                          if !showAuthorText
                            span(class="sr-only")= author.name

                    if showAuthorText
                      div(class="flex min-w-0 flex-col items-start gap-0.5 text-left")
                        div(class="flex flex-wrap items-center gap-x-2 gap-y-0.5")
                          span(class="font-body text-sm font-semibold text-ink")= author.name
                          span(class="inline-flex items-center text-xs leading-none text-primary" aria-hidden="true")
                            span= "★".repeat(review.rating)
                            if review.rating < 5
                              span(class="text-ink/20")= "★".repeat(5 - review.rating)
                          span(class="sr-only")= `${review.rating}/5`

                        if author.meta
                          span(class="font-body text-xs leading-snug text-ink-muted")= author.meta
                    else
                      span(class="inline-flex items-center text-xs leading-none text-primary" aria-hidden="true")
                        span= "★".repeat(review.rating)
                        if review.rating < 5
                          span(class="text-ink/20")= "★".repeat(5 - review.rating)
                      span(class="sr-only")= `${review.rating}/5`

        div(class="ui-carousel__pagination" data-js-carousel-pagination)

      if reviewsData.note
        p(class="text-center font-body text-xs leading-relaxed text-ink-muted")= reviewsData.note
